{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[ALL] Start Services",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/../../docker/scripts/start-services.sh\"",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[ALL] Stop Services",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[ALL] Restart Services",
      "type": "shell",
      "command": "docker compose restart",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run PHPUnit Tests",
      "type": "shell",
      "command": "docker compose run --rm --no-deps backend ./vendor/bin/phpunit tests",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run PHPUnit Tests (debug output)",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend ./vendor/bin/phpunit --debug --filter ${input:phpunitFilter}",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run Artisan Command",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend php artisan ${input:artisanCommand}",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Execute command",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend sh -c \"${input:backendCommand}\"",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Truncate All Tables",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend php artisan db:truncate --force",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Seed Database with Mock Data",
      "type": "shell",
      "command": "docker compose exec -T -e SEED_SCAMMERS=${input:seedScammers} -e SEED_CONTACTS=${input:seedContacts} -e SEED_PAYMENT_METHODS=${input:seedPaymentMethods} -e SEED_ORGANIZATIONS=${input:seedOrganizations} -e SEED_REPORTS=${input:seedReports} -e SEED_USERS=${input:seedUsers} -e SEED_PRODUCTS=${input:seedProducts} -w /var/www/backend backend php artisan db:seed --class=TestSeeder",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Cache] Clear Cache",
      "type": "shell",
      "command": "docker compose exec -T -w / cache redis-cli FLUSHALL",
      "options": {
        "cwd": "${workspaceFolder}/../../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
  ],
  "inputs": [
    {
      "id": "phpunitFilter",
      "type": "promptString",
      "description": "PHPUnit filter (e.g. PublicScammerControllerTest::testScammerSearchByCardNumber)",
      "default": "PublicScammerControllerTest"
    },
    {
      "id": "artisanCommand",
      "type": "promptString",
      "description": "Artisan command (e.g. php artisan db:seed)",
      "default": ""
    },
    {
      "id": "backendCommand",
      "type": "promptString",
      "description": "Command to run in the backend container (e.g. ls -la, php artisan migrate:status)",
      "default": ""
    },
    {
      "id": "seedScammers",
      "type": "promptString",
      "description": "SEED_SCAMMERS — number of scammers to create",
      "default": "1"
    },
    {
      "id": "seedContacts",
      "type": "promptString",
      "description": "SEED_CONTACTS — contacts per scammer/organization",
      "default": "3"
    },
    {
      "id": "seedPaymentMethods",
      "type": "promptString",
      "description": "SEED_PAYMENT_METHODS — payment methods per scammer/organization",
      "default": "3"
    },
    {
      "id": "seedOrganizations",
      "type": "promptString",
      "description": "SEED_ORGANIZATIONS — number of standalone organizations",
      "default": "1"
    },
    {
      "id": "seedReports",
      "type": "promptString",
      "description": "SEED_REPORTS — reports per scammer/organization",
      "default": "2"
    },
    {
      "id": "seedUsers",
      "type": "promptString",
      "description": "SEED_USERS — number of users to create",
      "default": "1"
    },
    {
      "id": "seedProducts",
      "type": "promptString",
      "description": "SEED_PRODUCTS — number of products to create",
      "default": "1"
    }
  ]
}
